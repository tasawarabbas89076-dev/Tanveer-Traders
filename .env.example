# APP_URL: The URL where this applet is hosted (e.g., https://your-domain.vercel.app or local http://localhost:3000)
APP_URL="http://localhost:3000"

# PORT: Server port (defaults to 3000)
PORT=3000

# SUPABASE CONFIGURATION (Optional for local preview; required for production Supabase database & auth)
# Get these from your Supabase Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ADMIN AUTHENTICATION
# Used for initial admin login setup or standalone JWT fallback session verification
ADMIN_EMAIL="admin@tanveertraders.com"
ADMIN_INITIAL_PASSWORD="ChangeThisSecurePassword123!"
ADMIN_JWT_SECRET="super-secret-jwt-key-replace-in-production-min-32-chars"

